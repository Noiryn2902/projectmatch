# Copy to .env.local and fill in. Every value here is optional: with none of
# them set the application runs against the deterministic seeded data.

# --- AI ---------------------------------------------------------------------
# Without this, every AI call uses its deterministic fallback and the app still
# works end to end.
GEMINI_API_KEY=your_key_here

# --- Database and auth ------------------------------------------------------
# From the Supabase dashboard: Settings -> API.
#
# The URL and anon key are public by design — the browser needs them to open a
# realtime socket, and row level security assumes they are known.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row level security, so it exists for exactly two jobs:
# accepting an invitation by token before the recipient has an account, and
# writing the audit log. Never give this a NEXT_PUBLIC_ prefix, and never
# reference it from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email ----------------------------------------------------------------
# Transactional email for invitation delivery, via Resend (resend.com). Both
# server only. Without them, every send logs to the server console instead and
# the invitation link is still shown on the project page — the flow works
# unplugged. EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
